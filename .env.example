# Copy to .env for local development (tsx/dotenv-free — see README for why).

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Required: the upstream MCP server SentinelMCP forwards allowed calls to.
MCP_UPSTREAM_URL=http://localhost:9090/mcp

# Optional: comma-separated tool names the mock policy store denies.
MCP_DENIED_TOOLS=delete_production_database,wire_transfer

MAX_BODY_BYTES=1048576
UPSTREAM_TIMEOUT_MS=15000
CORS_ORIGIN=*
SSE_HEARTBEAT_MS=20000

# Phase 3 — Origin header validation (DNS-rebinding mitigation).
# Optional: comma-separated exact-match allowlist. If unset, defaults to
# loopback-only (any port) — fine for local dev, NOT fine to leave unset
# for anything reachable beyond the same machine. Setting this REPLACES
# the loopback default; it does not extend it.
# ALLOWED_ORIGINS=https://your-trusted-client.example.com

# Phase 3 — real ID-JAG verification. All four required; there's no safe
# default for "which IdP / which resource should this gateway trust."
JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
ID_JAG_ISSUER=https://your-idp.example.com/
ID_JAG_AUDIENCE=sentinelmcp-gateway
ID_JAG_RESOURCE=https://your-upstream-mcp-server.internal

# Phase 4 — budget/cost-control policy. Ops-level knobs (as opposed to the
# token-shape calibration constants, which live in code in budgetGuard.ts
# since they're an engineering concern, not a business-policy one).
# Illustrative defaults below -- calibrate to your real provider pricing,
# team sizes, and burstiness tolerance.
DEFAULT_TEAM_TOKEN_BUDGET_7D=2000000
BUDGET_SPIKE_THRESHOLD_MULTIPLIER=5
OUTPUT_TOKEN_COST_WEIGHT=3

# Phase 5 — resume-token signing. Required, no default: generate with
# something like `openssl rand -base64 32`, not a human-chosen passphrase.
# MUST be identical across every replica -- see the warning in
# src/config/env.ts for why a per-replica-generated secret would silently
# break resume verification depending on which replica handles a given call.
HMAC_SECRET=replace-this-with-a-real-random-secret-at-least-32-chars
RESUME_TOKEN_TTL_MS=900000
