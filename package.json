{
  "name": "sentinelmcp",
  "version": "0.1.0",
  "description": "Stateless enterprise policy firewall and cost proxy for the Model Context Protocol (MCP).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch --test-reporter=spec 'test/**/*.test.ts'",
    "test:ci": "node --import tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/sensible": "^6.0.3",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
